# The two Rancher secrets (SD-4, SD-5, SD-7). Terraform creates each one empty and
# never holds a value, so no value reaches Terraform state (REQ-103.1):
# - the admin password is generated by Rancher and written by the Rancher host at
#   first boot (break-glass use only, REQ-021.1);
# - the sre-agent token is written by tools/lab/configure_rancher.py on each
#   rebuild (REQ-050.1). ADR-0002 may move it to AgentCore Identity.
# Both are refused to the coding agent's read-only role (REQ-013.1) and to the CI
# plan role. They are deleted at teardown without a recovery window, so that the
# next rebuild can create them again under the same names.

data "aws_iam_policy_document" "refuse_secret_reads" {
  statement {
    sid       = "RefuseValuesToCodingAgentAndCi"
    effect    = "Deny"
    actions   = ["secretsmanager:GetSecretValue"]
    resources = ["*"]

    principals {
      type        = "AWS"
      identifiers = ["*"]
    }

    condition {
      test     = "ArnLike"
      variable = "aws:PrincipalArn"
      values   = [local.coding_agent_role_pattern, local.ci_plan_role_arn]
    }
  }
}

resource "aws_secretsmanager_secret" "rancher_admin_password" {
  name                    = "sre-lab/rancher-admin-password"
  description             = "Rancher local admin password, generated by Rancher and written by the Rancher host at first boot. Break-glass only. Not managed by Terraform."
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_policy" "rancher_admin_password" {
  secret_arn = aws_secretsmanager_secret.rancher_admin_password.arn
  policy     = data.aws_iam_policy_document.refuse_secret_reads.json
}

resource "aws_secretsmanager_secret" "rancher_agent_token" {
  name                    = "sre-lab/rancher-agent-token"
  description             = "API token of the sre-agent Rancher user (read-only, 30-day expiry), written by tools/lab/configure_rancher.py. Not managed by Terraform."
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_policy" "rancher_agent_token" {
  secret_arn = aws_secretsmanager_secret.rancher_agent_token.arn
  policy     = data.aws_iam_policy_document.refuse_secret_reads.json
}
